<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <!-- JSON lines in the format set by logging.structured.format.console in application.yaml. -->
    <include resource="org/springframework/boot/logging/logback/structured-console-appender.xml"/>

    <!-- Spring Boot does not ship an OTLP log appender, so this one comes from OpenTelemetry and gets its
         OpenTelemetry instance from OpenTelemetryAppenderInitializer. It takes the trace and span ids from
         the active span; the MDC fields listed here become log attributes, searchable in Loki. -->
    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureMdcAttributes>entry_id,idempotency_key</captureMdcAttributes>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTEL"/>
    </root>
</configuration>
