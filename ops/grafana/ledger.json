{
  "uid": "tally-ledger",
  "title": "tally ledger",
  "description": "Metrics arrive over OTLP every 10 s, so each panel has a 10 s minimum interval instead of the data source's 60 s scrape interval.",
  "tags": [
    "tally"
  ],
  "editable": true,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "utc",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Postings per second by kind",
      "description": "Entries committed. Replayed requests are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (kind) (rate(ledger_postings_total[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Posting latency, posted entries",
      "description": "From the controller's call to the service until the commit returned.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ledger_posting_duration_milliseconds_bucket{outcome=\"posted\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ledger_posting_duration_milliseconds_bucket{outcome=\"posted\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ledger_posting_duration_milliseconds_bucket{outcome=\"posted\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Posting outcomes per second",
      "description": "posted, replayed, rejected (refused with 404, 409 or 422) or failed (anything else). A 400 is refused before the posting starts and is not counted here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (operation, outcome) (rate(ledger_posting_duration_milliseconds_count[$__rate_interval]))",
          "legendFormat": "{{operation}} {{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Balance lock wait",
      "description": "The one SELECT ... FOR UPDATE on a posting's balance rows: waiting for other postings' locks plus one round trip.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ledger_lock_wait_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ledger_lock_wait_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbox pending rows",
      "description": "Rows not yet published to Kafka. Every instance reads the same table, so max, not sum.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(ledger_outbox_pending)",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Outbox oldest unpublished row",
      "description": "Seconds since the oldest unpublished row was written. Rising steadily means the relay is stuck.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(ledger_outbox_oldest_age_seconds)",
          "legendFormat": "age"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Reconciliation drifted accounts",
      "description": "Accounts whose stored balance differed from the sum of their lines in the last reconciliation run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(ledger_reconciliation_drift_accounts)",
          "legendFormat": "drifted accounts"
        }
      ]
    }
  ]
}
